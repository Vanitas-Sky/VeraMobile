<resources>
    <!-- 1. Tema de la Splash Screen nativa -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_vera_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.VeraMobile</item>
    </style>

    <!-- 2. Tema principal de la App -->
    <style name="Theme.VeraMobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
